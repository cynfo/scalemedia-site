# Kopiér denne filen til .env og fyll inn verdiene. .env er gitignored.

# ── Claude API (nettside-generatoren) ────────────────────────────────────────
# Hentes fra https://console.anthropic.com/. Forlater ALDRI backend.
ANTHROPIC_API_KEY=sk-ant-din-nokkel-her

# Modell (valgfri). Sonnet er rask og god til kodegenerering.
ANTHROPIC_MODEL=claude-sonnet-4-6

# Maks antall tokens i svaret (valgfri). 12000 gir en komplett side. Med Sonnet
# tar en hel side ~90-130 sek -> krever Vercel Pro (maxDuration opptil 300s).
# For gratis Vercel Hobby (60s-grense): sett ANTHROPIC_MODEL til en Haiku-modell
# (mye raskere) ELLER senk MAX_TOKENS kraftig (gir enklere sider).
MAX_TOKENS=12000

# Timeout mot Claude i ms (valgfri).
GENERER_TIMEOUT_MS=180000

# Grov prisberegning for kostnadslogging, USD per million tokens (valgfri).
PRICE_IN_PER_MTOK=3
PRICE_OUT_PER_MTOK=15

# ── Rate limiting (kostnadskontroll, per IP per time) ─────────────────────────
RATE_LIMIT_GENERER=8
RATE_LIMIT_ITERER=20

# ── SMTP (lead-varsling via e-post) ──────────────────────────────────────────
# Brukes av /api/lead og /api/send-lead.
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=apikey
SMTP_PASS=din-sendgrid-api-nokkel

# Avsender (valgfri, faller tilbake til SMTP_USER)
SMTP_FROM=post@scalemedia.no

# Mottaker for leads (valgfri, standard: post@scalemedia.no)
LEAD_EMAIL=post@scalemedia.no
