# SMTP-innstillinger for e-postvarsling av leads
# Kopiér denne filen til .env og fyll inn verdiene

SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=apikey
SMTP_PASS=din-sendgrid-api-nokkel

# E-postadressen som avsender (valgfri, faller tilbake til SMTP_USER)
SMTP_FROM=post@scalemedia.no

# E-postadressen som mottar leads (valgfri, standard: post@scalemedia.no)
LEAD_EMAIL=post@scalemedia.no
