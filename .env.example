# Kopiér denne filen til .env og fyll inn verdiene. .env er gitignored.

# ── Claude API (nettside-generatoren) ────────────────────────────────────────
# Hentes fra https://console.anthropic.com/. Forlater ALDRI backend.
ANTHROPIC_API_KEY=sk-ant-din-nokkel-her

# Modell (valgfri).
#  - claude-opus-4-7   : maks kvalitet (~2-4 min/side). Standard. KREVER Vercel Pro (maxDuration 300s).
#  - claude-sonnet-4-6 : premium, ~90-130s. Krever også Vercel Pro.
#  - claude-haiku-4-5  : rask (~30s/side), passer gratis Vercel Hobby (60s). Enklere sider.
ANTHROPIC_MODEL=claude-opus-4-7

# Maks antall tokens i svaret (valgfri). 18000 gir en rik, komplett Opus-side
# (~3-4 min). Senk hvis det tar for lang tid; øk hvis sider blir avkuttet.
MAX_TOKENS=18000

# Timeout mot Claude i ms (valgfri). Hold under maxDuration i vercel.json.
# Pro: opptil 300000. Hobby (Haiku): hold under 60000.
GENERER_TIMEOUT_MS=290000

# Grov prisberegning for kostnadslogging, USD per million tokens (valgfri).
# Standard = Opus 4.7 ($5/$25). Sonnet $3/$15. Haiku $1/$5.
PRICE_IN_PER_MTOK=5
PRICE_OUT_PER_MTOK=25

# ── Bilder i genererte sider (valgfritt) ──────────────────────────────────────
# Modellen skriver {{IMG:nøkkelord}}-plassholdere; serveren bytter dem med ekte,
# relevante bilder. Med en gratis Unsplash-nøkkel blir bildene proffe; uten den
# brukes nøkkelord-baserte LoremFlickr-bilder. Nøkkel: https://unsplash.com/developers
# UNSPLASH_ACCESS_KEY=din-unsplash-access-key

# ── Rate limiting (kostnadskontroll, per IP per vindu) ────────────────────────
# Hver IP får 2 sider + 8 endringer per døgn. Lavt fordi Opus er dyrt.
# RATE_WINDOW_MS styrer tidsvinduet (standard 86400000 = 1 døgn).
RATE_LIMIT_GENERER=2
RATE_LIMIT_ITERER=8
RATE_WINDOW_MS=86400000

# Vanntett per-IP-grense på tvers av alle serverless-instanser (Lag 3).
# Opprett "Upstash for Redis (KV)" i Vercel → Storage; da settes disse automatisk.
# Uten dem faller rate-limiteren tilbake til en (mykere) teller i minnet.
# KV_REST_API_URL=https://...upstash.io
# KV_REST_API_TOKEN=...

# ── SMTP (lead-varsling via e-post) ──────────────────────────────────────────
# Brukes av /api/lead og /api/send-lead.
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=apikey
SMTP_PASS=din-sendgrid-api-nokkel

# Avsender (valgfri, faller tilbake til SMTP_USER)
SMTP_FROM=post@scalemedia.no

# Mottaker for leads (valgfri, standard: post@scalemedia.no)
LEAD_EMAIL=post@scalemedia.no
